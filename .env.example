# ---- Core ----
# PostgreSQL connection string (Supabase Postgres, Neon, RDS or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fincrime?schema=public"
# Public base URL used in emails, certificates and sitemap
APP_URL="http://localhost:3000"
# 32+ random bytes, e.g. `openssl rand -base64 48`. REQUIRED in production.
AUTH_SECRET="change-me-in-production-use-a-long-random-string"

# ---- Payments (Stripe) ----
# When unset, checkout runs in clearly-labelled DEVELOPMENT mode (disabled when NODE_ENV=production).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- Email ----
# "log" (default) stores emails in the EmailLog table; "resend" sends via Resend API.
EMAIL_PROVIDER="log"
RESEND_API_KEY=""
EMAIL_FROM="FinCrime Academy <no-reply@example.com>"

# ---- File storage ----
# "local" writes to ./storage (development). Production: configure S3-compatible storage.
STORAGE_DRIVER="local"

# ---- Seed ----
SEED_ADMIN_EMAIL="admin@fincrime.academy"
SEED_ADMIN_PASSWORD="ChangeMe!Admin2026"
RATE_LIMIT_MULTIPLIER="1"
